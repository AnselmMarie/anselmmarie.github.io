# Example configuration only — placeholders, never real values (D11).
# This repo is public. Every value below is a stand-in.

# Where the shell resolves each remote's `remoteEntry.js` at runtime (D19).
# In development these point at the local Vite dev servers; in a deployed
# environment they are the remote's CloudFront URL (D31). Slice 8 supplies
# the deployed values from the environment rather than a constant.
PORTFOLIO_REMOTE_HEADER_URL=http://localhost:3001/remoteEntry.js
PORTFOLIO_REMOTE_FOOTER_URL=http://localhost:3002/remoteEntry.js
PORTFOLIO_REMOTE_HOMEPAGE_URL=http://localhost:3003/remoteEntry.js
PORTFOLIO_REMOTE_PORTFOLIO_ITEM_URL=http://localhost:3004/remoteEntry.js

# The canonical origin the shell uses to build absolute Open Graph URLs (D48).
PORTFOLIO_SITE_ORIGIN=http://localhost:3000

# ⚠️ Contentful is deliberately NOT in this plan and no slice here may read a
# credential. The keys are listed so the shape is on record for the plan that
# adds them; leave them unset.
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=
# CONTENTFUL_ENVIRONMENT=
