{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "footer",
  "projectType": "application",
  "sourceRoot": "apps/footer/src",
  "tags": ["type:app", "scope:footer"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite dev",
        "cwd": "apps/footer"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "apps/footer"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/footer"
      }
    }
  }
}
