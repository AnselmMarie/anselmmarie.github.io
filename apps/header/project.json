{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "header",
  "projectType": "application",
  "sourceRoot": "apps/header/src",
  "tags": ["type:app", "scope:header"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "vite dev", "cwd": "apps/header" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "vite build", "cwd": "apps/header" }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": { "command": "vite preview", "cwd": "apps/header" }
    }
  }
}
