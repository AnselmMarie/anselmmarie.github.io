{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "infra",
  "projectType": "application",
  "sourceRoot": "infra/src",
  "tags": ["type:infra", "scope:infra"],
  "targets": {
    "synth": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/cdk.out"],
      "options": {
        "command": "cdk synth",
        "cwd": "infra"
      }
    }
  }
}
