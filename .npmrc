supportedArchitectures[os][]=current
supportedArchitectures[os][]=linux
supportedArchitectures[cpu][]=current
supportedArchitectures[cpu][]=x64
supportedArchitectures[libc][]=current
supportedArchitectures[libc][]=glibc

# Hoist rollup and swc native platform binaries to the root node_modules so
# bundlers can resolve them through pnpm's isolated layout.
public-hoist-pattern[]=@rollup/*
public-hoist-pattern[]=@swc/core-*

# Explicitly exclude @esbuild/* from BOTH the virtual store hoist and the
# public hoist. Multiple esbuild versions coexist in the workspace
# (vite 7 → 0.27.x, vitest → 0.25.x, nx-esbuild → 0.19.x, jest-expo → 0.18.x).
# If any single @esbuild/<platform> version is hoisted, other esbuild versions
# fall back to it via Node's upward node_modules resolution and hit:
#   "Host version X does not match binary version Y"
# Forcing each esbuild to resolve only through its own isolated node_modules
# keeps host/binary versions paired correctly.
hoist-pattern[]=*
hoist-pattern[]=!@esbuild/*
public-hoist-pattern[]=!@esbuild/*
