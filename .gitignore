# Next.js
.next
out
# Regenerated by `next build`/`next dev`, which writes it with double quotes
# while the repo's formatter rewrites them to single — so it shows as modified
# after every run without anyone touching it.
next-env.d.ts

# OpenNext (Cloudflare Workers build output)
.open-next

# Uniwind's generated CSS artifact, one per bundler so two never race on a
# shared one (tools/uniwind/uniwind-artifact.cjs). Regenerated on every build.
apps/*/src/styles/uniwind.generated.css
libs/ui/storybook/src/styles/generated/
