{
  "name": "anselmmarie.github.io",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "nx run shell:dev",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "sync": "nx sync",
    "sync:check": "nx sync:check",
    "format": "biome check --write",
    "format:check": "biome check",
    "check:file-size": "node tools/scripts/check-file-size.mjs",
    "e2e:build": "node tools/scripts/e2e-stack.mjs",
    "e2e": "playwright test",
    "check:project-tags": "node tools/scripts/check-project-tags.mjs",
    "check:react-major": "node tools/scripts/check-react-major.mjs",
    "aws:deploy": "pnpm --filter @portfolio/infra exec tsx src/deploy/cli.ts deploy",
    "aws:rollback": "pnpm --filter @portfolio/infra exec tsx src/deploy/cli.ts rollback",
    "aws:versions": "pnpm --filter @portfolio/infra exec tsx src/deploy/cli.ts versions",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "biome check --write --no-errors-on-unmatched",
      "node tools/scripts/check-file-size.mjs"
    ],
    "*.{json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "docs/planning/**/*.md": [
      "node tools/scripts/check-file-size.mjs"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@module-federation/vite": "^1.22.1",
    "@nx/eslint": "21.6.11",
    "@nx/eslint-plugin": "^21.0.0",
    "@nx/js": "21.6.11",
    "@nx/vite": "21.6.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "nx": "^21.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "@biomejs/biome"
    ]
  }
}
